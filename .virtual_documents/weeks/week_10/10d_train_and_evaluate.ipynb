else:
    import matplotlib.pyplot as plt
    import matplotlib.ticker as ticker
    from matplotlib.lines import Line2D

    # ── Style ─────────────────────────────────────────────────────────────
    plt.rcParams.update({
        "font.family":       "serif",
        "font.size":         11,
        "axes.spines.top":   False,
        "axes.spines.right": False,
        "axes.grid":         False,
        "xtick.direction":   "out",
        "ytick.direction":   "out",
        "figure.dpi":        150,
    })

    # ── Muted scientific palette ───────────────────────────────────────────
    _EXP_COLORS = [
        "#A45C6A",  # E0 dusty rose
        "#6B9E78",  # E1 sage green
        "#C4956A",  # E2 warm ochre
        "#7B6FA0",  # E3 muted violet
        "#4E8098",  # E4 teal
        "#B5794A",  # E5 terracotta
        "#7A9E7E",  # E6 moss green
        "#9E6B8A",  # E7 mauve
    ]

    PALETTE = {
        "classical": "#5B7FA6",
        "oracle":    "#4A4A4A",
        "ref_line":  "#9AABBF",
    }
    # Assign colors dynamically to all experiments in scoreboard
    for i, exp in enumerate(sorted(scoreboard["experiment"].unique())):
        PALETTE[exp] = _EXP_COLORS[i % len(_EXP_COLORS)]

    # ── Data prep ─────────────────────────────────────────────────────────
    best_rows = (
        scoreboard.sort_values("nll_mean")
        .groupby("experiment", sort=False)
        .first()
        .reset_index()
    )

    exp_names       = sorted(best_rows["experiment"].tolist())
    bar_labels      = ["Classical"] + exp_names
    bar_nlls        = [nll_cl_val] + [
        best_rows.loc[best_rows["experiment"] == n, "nll_mean"].values[0]
        for n in exp_names
    ]
    bar_errs        = [0.0] + [
        best_rows.loc[best_rows["experiment"] == n, "nll_std"].values[0]
        for n in exp_names
    ]
    oracle_nlls_bar = [None] + [
        best_rows.loc[best_rows["experiment"] == n, "oracle_nll_mean"].values[0]
        for n in exp_names
    ]
    oracle_errs_bar = [None] + [
        best_rows.loc[best_rows["experiment"] == n, "oracle_nll_std"].values[0]
        for n in exp_names
    ]
    bar_colors = [PALETTE["classical"]] + [
        PALETTE.get(n, "#999999") for n in exp_names
    ]

    # ── Best experiment for panel 3 ───────────────────────────────────────
    best_exp_name = best_rows.iloc[0]["experiment"]
    best_exp_cfg  = EXPERIMENTS[best_exp_name]

    # ── Layout ────────────────────────────────────────────────────────────
    has_cfg  = (scoreboard["guidance_w"] > 0).any()
    n_panels = 3 if has_cfg else 2
    fig, axes = plt.subplots(
        1, n_panels,
        figsize=(5 * n_panels + 3, 5),
        gridspec_kw={"wspace": 0.40},
    )

    # ── Panel 1 — bar chart ───────────────────────────────────────────────
    ax = axes[0]
    x  = np.arange(len(bar_labels))
    w  = 0.55

    ax.bar(
        x, bar_nlls, width=w,
        color=bar_colors,
        edgecolor="white", linewidth=0.6,
        yerr=bar_errs, capsize=3,
        error_kw={"elinewidth": 1.2, "ecolor": "#444444"},
        zorder=3,
    )

    for i, (o_nll, o_err) in enumerate(zip(oracle_nlls_bar, oracle_errs_bar)):
        if o_nll is None:
            continue
        ax.hlines(
            o_nll,
            x[i] - w / 2 + 0.02, x[i] + w / 2 - 0.02,
            colors=PALETTE["oracle"], linewidths=1.2,
            linestyles="--", zorder=4,
        )
        ax.fill_between(
            [x[i] - w / 2 + 0.02, x[i] + w / 2 - 0.02],
            o_nll - o_err, o_nll + o_err,
            color=PALETTE["oracle"], alpha=0.10, zorder=2,
        )

    ax.axhline(
        nll_cl_val,
        color=PALETTE["ref_line"], linewidth=0.8,
        linestyle=":", zorder=2, alpha=0.9,
    )

    ax.set_xticks(x)
    ax.set_xticklabels(bar_labels, fontsize=12)
    ax.set_ylabel("Hard-gated NLL (val)", fontsize=14)
    ax.set_title(
        "Val NLL By Experiment\n(dashed = Oracle Upper Bound)",
        fontsize=14, pad=10,
    )

    all_vals = bar_nlls + [o for o in oracle_nlls_bar if o is not None]
    ax.set_ylim(min(all_vals) - 0.05, max(all_vals) + 0.08)
    ax.yaxis.set_major_formatter(ticker.FormatStrFormatter("%.2f"))

    legend_elements = [
        Line2D([0], [0], color=PALETTE["oracle"],   linewidth=1.2,
               linestyle="--", label="Oracle Upper Bound"),
        Line2D([0], [0], color=PALETTE["ref_line"], linewidth=0.8,
               linestyle=":",  alpha=0.9, label="Classical Baseline"),
    ]
    ax.legend(handles=legend_elements, frameon=False, fontsize=12, loc="upper left")

    # ── Panel 2 — CFG guidance sweep ──────────────────────────────────────
    if has_cfg:
        ax2 = axes[1]
        cfg_data = scoreboard[scoreboard["guidance_w"] > 0]
        cfg_exps = cfg_data["experiment"].unique()
        for exp in cfg_exps:
            sub = scoreboard[scoreboard["experiment"] == exp].sort_values("guidance_w")
            ax2.errorbar(
                sub["guidance_w"], sub["nll_mean"], yerr=sub["nll_std"],
                marker="o", markersize=5, linewidth=1.4, capsize=3,
                label=exp, color=PALETTE.get(exp, "#999999"),
            )
        ax2.axhline(
            nll_cl_val,
            color=PALETTE["ref_line"], linewidth=0.8,
            linestyle=":", alpha=0.9, label="Classical",
        )
        ax2.set_xlabel("Guidance Weight $w$", fontsize=14)
        ax2.set_ylabel("Hard-gated NLL (val)", fontsize=14)
        ax2.set_title("CFG Guidance Sweep", fontsize=14, pad=10)
        ax2.legend(frameon=False, fontsize=12)

    # ── Panel 3 — per-hemicycle NLL breakdown for best experiment ─────────
    ax3 = axes[-1]

    # Load best experiment and sample residuals per val hemicycle
    lit_best, train_ds_best, _, _ = load_trained_experiment(
        best_exp_name, best_exp_cfg, windows_aug, _WEEK10_DIR, alpha_np, sigma_np
    )
    lit_best = lit_best.to(device).eval()

    val_hcs_local = [hc for hc in hemicycles if hc["split"] == "val"]
    keys_p3, cond_p3 = block_cond_concat(val_hcs_local, lit_best, best_exp_cfg, train_ds_best)

    # Sample K residuals
    cond_K_p3 = cond_p3.repeat_interleave(K, dim=0)
    with torch.no_grad():
        samples_p3 = sample_conditional_extended(
            lit_best, cond_K_p3, guidance_w=0.0, device=device
        ).cpu().numpy()
    N_p3 = len(keys_p3)
    samples_NK15_p3 = samples_p3.reshape(N_p3, K, 15)

    # Per-hemicycle NLL
    hc_labels, hc_cl_nlls, hc_diff_nlls, hc_diff_stds = [], [], [], []
    for hc in val_hcs_local:
        # Classical NLL for this hemicycle
        nll_cl_hc, det_hc = hard_nll_classical(classical, [hc])
        if not np.isfinite(nll_cl_hc):
            continue

        # Diffusion NLL for this hemicycle
        hc_keys = [(hc["cycle"], hc["hemisphere"], blk["center_decimal"])
                   for blk in hc["blocks"]]
        hc_idx  = [keys_p3.index(k) for k in hc_keys if k in keys_p3]
        if not hc_idx:
            continue
        hc_samples = samples_NK15_p3[hc_idx]  # (n_blocks, K, 15)

        hc_nlls_k = []
        for k in range(K):
            rbb = {keys_p3[i]: hc_samples[j, k]
                   for j, i in enumerate(hc_idx)}
            nll_k, _ = hard_nll_combined(classical, [hc], rbb)
            if np.isfinite(nll_k):
                hc_nlls_k.append(nll_k)

        if not hc_nlls_k:
            continue

        label = f"C{hc['cycle']}\n{hc['hemisphere'][0].upper()}"
        hc_labels.append(label)
        hc_cl_nlls.append(nll_cl_hc)
        hc_diff_nlls.append(float(np.mean(hc_nlls_k)))
        hc_diff_stds.append(float(np.std(hc_nlls_k)))

    x3  = np.arange(len(hc_labels))
    w3  = 0.35

    ax3.bar(
        x3 - w3 / 2, hc_cl_nlls, width=w3,
        color=PALETTE["classical"], alpha=0.85,
        edgecolor="white", linewidth=0.5,
        label="Classical", zorder=3,
    )
    ax3.bar(
        x3 + w3 / 2, hc_diff_nlls, width=w3,
        color=PALETTE[best_exp_name], alpha=0.85,
        edgecolor="white", linewidth=0.5,
        yerr=hc_diff_stds, capsize=2,
        error_kw={"elinewidth": 0.9, "ecolor": "#444444"},
        label=best_exp_name, zorder=3,
    )

    ax3.set_xticks(x3)
    ax3.set_xticklabels(hc_labels, fontsize=8)
    ax3.set_ylabel("Hard-gated NLL", fontsize=14)
    ax3.set_title(
        f"Per-hemicycle NLL\n(best variant: {best_exp_name})",
        fontsize=14, pad=10,
    )
    ax3.legend(frameon=False, fontsize=10, loc="upper right")
    hc_all_vals = hc_cl_nlls + hc_diff_nlls
    ax3.set_ylim(min(hc_all_vals) - 0.05, max(hc_all_vals) + 0.10)
    ax3.yaxis.set_major_formatter(ticker.FormatStrFormatter("%.2f"))

    # Move legend outside panel 3
    ax3.legend(frameon=False, fontsize=10, loc="upper left",
               bbox_to_anchor=(1.01, 1), borderaxespad=0)

    # Fix title overlap — remove ax title, put info in suptitle
    ax.set_title("Val NLL By Experiment\n(dashed = oracle upper bound)",
                 fontsize=12, pad=8)
    ax3.set_title(f"Per-hemicycle NLL (best: {best_exp_name})",
                  fontsize=12, pad=8)

    fig.suptitle(
        "Diffusion Model Ablation (Val Split)",
        fontsize=14, fontweight="bold", y=1.01,
    )
