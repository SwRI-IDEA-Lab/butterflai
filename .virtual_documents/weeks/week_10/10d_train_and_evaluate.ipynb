# Task 61 — attach contemporaneous opposite-hemisphere summaries.

# Build calendar-time key
_t0_lookup = {
    (int(c), str(h)): classical.lookup_t0(int(c), h)
    for (c, h) in classical.known_hemicycles()
}
windows_aug["decimal_year"] = windows_aug.apply(
    lambda r: (
        r["tau_center"]
        + _t0_lookup.get((int(r["cycle"]), str(r["hemisphere"])), np.nan)
    ),
    axis=1,
)

# Split into north and south pools
_north = windows_aug[windows_aug["hemisphere"] == "north"][
    ["decimal_year", "area_smoothed", "mu_universal", "amplitude"]
].copy()
_south = windows_aug[windows_aug["hemisphere"] == "south"][
    ["decimal_year", "area_smoothed", "mu_universal", "amplitude"]
].copy()


def find_nearest_opp(row, opp_df, max_gap=0.6):
    """Find nearest opposite-hemisphere row within max_gap years.

    Args:
        row: DataFrame row for the current window.
        opp_df: DataFrame of opposite-hemisphere windows.
        max_gap: Maximum calendar-year gap allowed for a valid match.

    Returns:
        Tuple of (values array, valid flag).
    """
    diffs = (opp_df["decimal_year"] - row["decimal_year"]).abs()
    idx = diffs.idxmin()
    if diffs[idx] <= max_gap:
        return opp_df.loc[
            idx, ["area_smoothed", "mu_universal", "amplitude"]
        ].values, 1.0
    return np.array([np.nan, np.nan, np.nan]), 0.0


# Find nearest opposite-hemisphere window for each row
opp_vals = []
for _, row in windows_aug.iterrows():
    opp_df = _south if row["hemisphere"] == "north" else _north
    vals, valid = find_nearest_opp(row, opp_df)
    opp_vals.append([*vals, valid])

opp_arr = np.array(opp_vals)
windows_aug["opp_area_smoothed"] = opp_arr[:, 0]
windows_aug["opp_mu_universal"] = opp_arr[:, 1]
windows_aug["opp_amplitude"] = opp_arr[:, 2]
windows_aug["opp_valid"] = opp_arr[:, 3]

# Impute unmatched rows with train-set means
_opp_cols = ["opp_area_smoothed", "opp_mu_universal", "opp_amplitude"]
_train_mask = (windows_aug["split"] == "train") & (windows_aug["opp_valid"] == 1.0)
for _c in _opp_cols:
    _mean = windows_aug.loc[_train_mask, _c].mean()
    windows_aug[_c] = windows_aug[_c].fillna(_mean)

print(f"after merge: {len(windows_aug)}")
print(f"opp_valid coverage: {windows_aug['opp_valid'].mean():.3f}")
print(
    f"opp_area_smoothed (train, valid): "
    f"mean={windows_aug.loc[_train_mask, 'opp_area_smoothed'].mean():.3f}, "
    f"std={windows_aug.loc[_train_mask, 'opp_area_smoothed'].std():.3f}"
)


for gap in [0.6, 1.0, 1.5, 2.0, 3.0]:
    count = 0
    for _, row in windows_aug.iterrows():
        opp_df = _south if row["hemisphere"] == "north" else _north
        diffs = (opp_df["decimal_year"] - row["decimal_year"]).abs()
        if diffs.min() <= gap:
            count += 1
    print(f"max_gap={gap:.1f}: coverage={count / len(windows_aug):.3f}")


