_BASE_TEMPLATE = {
    "arch": "concat",
    "consumed_keys": ["cond_base"],
    "groups": ["base"],
    "hidden_dim": 128,
    "n_layers": 3,
    "fourier": False,
    "cond_dropout_p": 0.0,
    "max_epochs": 20000,
    "lr": 1e-3,
    "batch_size": 64,
}


def _spec(**overrides):
    d = dict(_BASE_TEMPLATE)
    d.update(overrides)
    return d


EXPERIMENTS = {
    "E0": _spec(),  # baseline — same 4-D cond on the v2 parquet
    "E1": _spec(
        consumed_keys=["cond_base", "cond_opp"],
        groups=["base", "opp"],
    ),  # add opposite-hemisphere summaries as a second conditioning group
    "E2": _spec(
        consumed_keys=["cond_base", "cond_traj"],
        groups=["base", "traj"],
    ), # does knowing the direction and rate of change of activity improve val NLL over the base 4-vector alone, with architecture held constant?
    "E3": _spec(
        consumed_keys=["cond_base", "cond_cyclehemi"],
        groups=["base", "cyclehemi"],
    ), # does cycle identity beyond amplitude improve val NLL over base alone?
    "E4": _spec(
        arch="film",
    ), # does FiLM modulation close the gap with classical, with base cond held fixed?
    "E5": _spec(
    arch="film",
    consumed_keys=["cond_base", "cond_traj"],
    groups=["base", "traj"],
),  # Level 3 — best mechanism (FiLM) × best Level 1 cond (traj) — is the gain additive?
    "E6": _spec(
    arch="film",
    cond_dropout_p=0.1,
) #an sharpening E4's conditional density via classifier-free guidance buy margin below E4's 3.2215?
}

